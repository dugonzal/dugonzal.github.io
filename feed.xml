---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link rel="alternate" href="{{ site.url }}{{ '/' | relative_url }}"/>
  <link rel="self" href="{{ site.url }}{{ '/feed.xml' | relative_url }}"/>
  <id>{{ site.url }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author }}</name><email>{{ site.email }}</email></author>
{% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | truncatewords: 45 | xml_escape }}</summary>
  </entry>
{% endfor %}
</feed>
